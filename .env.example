# ---- 模型接口（OpenAI 兼容）----
# 主路由：所有用途共用这把 key 和地址，模型按用途分开配
DIGEST_API_KEY=
DIGEST_BASE_URL=https://api.example.com/v1/chat/completions
# 缺省模型；下面没单独配的用途都退回它
DIGEST_MODEL=
# 蒸馏抽取、新事顶旧事初判（建议强档）
EXTRACT_MODEL=
# 召回精排（每轮对话都会调，建议便宜档）
RERANK_MODEL=
# 新事顶旧事复核（建议强档；不配则退回 EXTRACT_MODEL）
TIMELINE_CONFIRM_MODEL=
# 夜间聚类归纳（开 CLUSTER_SUMMARY 时必须显式配）
CLUSTER_MODEL=
# 开 RERANK_FLASH 时的精排模型
RERANK_FLASH_MODEL=

# 备用路由：主路由失败（限流、欠费、超时）时自动切换
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=

# ---- 向量检索（Cloudflare Workers AI，bge-m3）----
# 不配则只用关键词召回
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ---- 功能开关，见 README「推荐配置」----
