# ---- 模型接口（OpenAI 兼容）----
# 主路由：所有用途共用这把 key 和地址，模型按用途分开配
DIGEST_API_KEY=
DIGEST_BASE_URL=https://api.example.com/v1/chat/completions
# 缺省模型；下面没单独配的用途都退回它
DIGEST_MODEL=
# 蒸馏抽取、新事顶旧事初判（建议强档）
EXTRACT_MODEL=
# 召回精排（每轮对话都会调，建议便宜档）
RERANK_MODEL=
# 新事顶旧事复核（建议强档；不配则退回 EXTRACT_MODEL）
TIMELINE_CONFIRM_MODEL=
# 夜间聚类归纳（开 CLUSTER_SUMMARY 时必须显式配）
CLUSTER_MODEL=
# 开 RERANK_FLASH 时的精排模型
RERANK_FLASH_MODEL=

# 备用路由：主路由失败（限流、欠费、超时）时自动切换
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=

# ---- 向量检索（Cloudflare Workers AI，bge-m3）----
# 不配则只用关键词召回
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ---- 功能开关，见 README「推荐配置」----

# 交叉编码器精排（RECALL_V2=1 时用；不配则用 DIGEST_BASE_URL 所在服务商的 /v1/rerank 与 DIGEST_API_KEY）
XRERANK_URL=
XRERANK_API_KEY=
XRERANK_MODEL=BAAI/bge-reranker-v2-m3

# 推荐开关（代码默认全关；说明见 README「推荐配置」「功能开关」）
ENGRAM_RAW_ONLY=1
ENGRAM_DISTILL_SLICE=1
ENGRAM_TIMELINE=1
ENGRAM_INVALIDATE_CHAIN=1
ENGRAM_TIMELINE_CONFIRM=1
ENGRAM_METAMEM=1
ENGRAM_CONTEXT_ROUTE=1
ENGRAM_SELF_REMEMBER=1
ENGRAM_CLUSTER_SUMMARY=1
ENGRAM_RECALL_V2=1
