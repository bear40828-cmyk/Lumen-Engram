# persona.env 示例：部署相关的「人」配置。复制成 persona.env（已被 .gitignore 忽略）后按自己的部署改。
# 不配的项使用 persona.py 里的通用默认值，系统照常能跑。
#
# 说话人标签：写进库里的身份标识，部署后不要再改，否则旧数据对不上。
ENGRAM_ACTOR_USER=user
ENGRAM_ACTOR_AGENT_C=agent_c
#
# 显示名：注入记忆、写提示词时怎么称呼各方
ENGRAM_NAME_USER=用户
ENGRAM_USER_FULLNAME=
ENGRAM_USER_ALIASES=
ENGRAM_NAME_CLAUDE=助手
ENGRAM_CLAUDE_ALIASES=
ENGRAM_NAME_GPT=其他助手
ENGRAM_GPT_ALIASES=
ENGRAM_NAME_AGENT_C=第三方助手
ENGRAM_DESC_GPT=AI
ENGRAM_DESC_AGENT_C=AI
# 对话里会出现的其他 AI 的名字，用于识别转述
ENGRAM_OTHER_AI_TERMS=
#
# 消息来源：聊天通道的数字 id 或机器人名 → 说话人标签，例如 123456:user,654321:agent_c
ENGRAM_CHANNEL_IDS=
ENGRAM_CHANNEL_NAMES=
ENGRAM_MAILBOX_ALIASES=
ENGRAM_MAILBOX_LOG=
ENGRAM_ATTACH_TAG=attach
#
# 路由与抽取用的词表（逗号分隔，按自己的领域填）
# 寒暄/应答类，不触发召回
ENGRAM_SOFT_TERMS=嗯嗯,哈哈,好的
ENGRAM_DOMAIN_TERMS=
ENGRAM_GATE_TERMS=
ENGRAM_ENTITY_TERMS=
ENGRAM_TOPIC_TERMS=
ENGRAM_CONTEXT_MARKS=
ENGRAM_RELAY_SPEAKERS=
ENGRAM_PERSON_REGEX=
ENGRAM_PERSON_SHORT=
ENGRAM_PLACE_TERMS=
ENGRAM_CLASSIFY_TERMS=
ENGRAM_SLOT_TERMS=
ENGRAM_ROUTER_PERSON_TERMS=
# 线索1|线索2=>候选里不许出现的词；多组用分号隔开
ENGRAM_ENTITY_GUARDS=
ENGRAM_PET_NAME=
ENGRAM_EXAMPLE_PLAYFUL=
ENGRAM_EXAMPLE_SHORT=
ENGRAM_MISS_HINT=
#
# 路径
ENGRAM_ENV_FILE=/path/to/llm.env
ENGRAM_TRANSCRIPT_DIR=/path/to/transcripts
ENGRAM_DIGEST_DIR=/path/to/digests
ENGRAM_HOOK_PATH=/path/to/hook.py
ENGRAM_PROMPT_GLOSSARY_FILE=/path/to/prompt-glossary.txt
ENGRAM_KEYS_FILE=/path/to/keys.local.yaml
# 助手自记上限
ENGRAM_REMEMBER_PER_SESSION=3
ENGRAM_REMEMBER_PER_DAY=5
